---
import "../../styles/global.css";

// define the component props
interface Props {
  title: string;
  description?: string;
}

// get props passed to the component
const { title, description } = Astro.props;
---

<!doctype html>
<html class="bg-gray-900 text-gray-200">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width"/>

    <title>{title}</title>

    {description && (
      <meta name="description" content={description}/>
    )}
    <link rel="icon" type="image/png" href="https://github.com/arfshl.png"/>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link 
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap" 
      rel="stylesheet"
    />
  </head>

  <body class="min-w-0 bg-gray-900 font-mono text-gray-200">
    <header class="border-b border-gray-700 bg-gray-900">
      <nav class="mx-auto flex w-[calc(100%-2rem)] max-w-6xl items-center justify-between py-5">
        <a href="/blog/" class="text-base md:text-lg font-bold text-gray-100 transition hover:text-gray-100">
          arfshl/blog
        </a>

        <div class="flex items-center gap-3 text-xs md:text-sm md:gap-4">
          <a href="/blog/" class="text-gray-400 transition hover:text-gray-100">
            Articles
          </a>

          <a href="/" class="text-gray-400 transition hover:text-gray-100">
            Portofolio
          </a>

          <a href="https://github.com/arfshl" target="_blank" rel="noopener noreferrer" class="text-gray-400 transition hover:text-gray-100">
            GitHub
          </a>
        </div>
      </nav>
    </header>

    <main class="mx-auto w-[calc(100%-2rem)] max-w-6xl py-10 sm:py-14">
      <slot />
    </main>

    <footer class="mx-auto w-[calc(100%-2rem)] max-w-6xl border-t border-gray-700 py-8 text-center text-xs md:text-sm text-gray-500">
      <p>© 2026 - Present. Alif Putra Winata. All rights reserved. </p>
    </footer>
  </body>
</html>