---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

// Get all blog posts
const posts = await getCollection("blog");

// Sort posts from newest to oldest
const sortedPosts = posts.sort(
  (a, b) =>
    new Date(b.data.date).getTime() -
    new Date(a.data.date).getTime(),
);

// Get the three latest posts for the featured section
const latestPosts = sortedPosts.slice(0, 3);

const postsPerPage = 10;

// Get the remaining posts for the paginated section
const remainingPosts = sortedPosts.slice(3);

// Get the posts displayed on the first pagination page
const firstPagePosts = remainingPosts.slice(0, postsPerPage);

// Check whether additional pagination pages are needed
const hasMorePages = remainingPosts.length > postsPerPage;
---

<Layout title="arfshl/blog">

  <section class="mb-12">
    <div class="mb-6 flex items-center justify-between">
      <h2 class="text-xl font-bold text-gray-100">
        Latest
      </h2>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {latestPosts.map((post) => (
        <article class="group rounded-xl border border-gray-700 bg-gray-800 p-6 shadow-lg">
          <div class="mb-4 flex flex-wrap items-center gap-2 text-xs">
            <span class="rounded-md bg-cyan-400/10 px-2 py-1 text-cyan-300">
              {post.data.category}
            </span>

            <span class="text-gray-500">
              {new Date(post.data.date).toLocaleDateString("en-US", {
                year: "numeric",
                month: "short",
                day: "numeric",
              })}
            </span>
          </div>

          <h3 class="mb-3 text-xl font-bold text-gray-100">
            <a
              href={`/blog/${post.data.category}/${post.data.slug}/`}
              class="transition group-hover:text-gray-400"
            >
              {post.data.title}
            </a>
          </h3>

          {post.data.description && (
            <p class="text-gray-400">
              {post.data.description}
            </p>
          )}

          <span class="mt-4 inline-block rounded bg-gray-700 px-2 py-1 text-xs text-gray-400">
            #{post.data.tags}
          </span>
        </article>
      ))}
    </div>
  </section>

  <section>
    <div class="mb-6 flex items-center justify-between">
      <h2 class="text-xl font-bold text-gray-100">
        All articles
      </h2>

      <span class="text-sm text-gray-500">
        {remainingPosts.length} posts
      </span>
    </div>

    {firstPagePosts.length > 0 ? (
      <div class="space-y-4">
        {firstPagePosts.map((post) => (
          <article class="group rounded-xl border border-gray-700 bg-gray-800 p-5 shadow-lg sm:p-6">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
              <div class="min-w-0 flex-1">
                <div class="mb-2 flex flex-wrap items-center gap-2 text-xs">
                  <span class="rounded-md bg-cyan-400/10 px-2 py-1 text-cyan-300">
                    {post.data.category}
                  </span>

                  <span class="text-gray-500">
                    {new Date(post.data.date).toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "short",
                      day: "numeric",
                    })}
                  </span>
                </div>

                <h3 class="mb-2 text-xl font-bold text-gray-100">
                  <a href={`/blog/${post.data.category}/${post.data.slug}/`} class="transition group-hover:text-gray-400" >
                    {post.data.title}
                  </a>
                </h3>

                <p class="text-sm leading-6 text-gray-400">
                  {post.data.description}
                </p>
              </div>

              <span class="shrink-0 self-start rounded bg-gray-700 px-2 py-1 text-xs text-gray-400 sm:self-center">
                #{post.data.tags}
              </span>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="rounded-xl border border-dashed border-gray-700 bg-gray-800 p-10 text-center">
        <p class="text-gray-500">
          No new article.
        </p>
      </div>
    )}

    {hasMorePages && (
      <nav
        class="mt-10 flex items-center justify-center"
        aria-label="Blog pagination"
      >
        <a
          href="/blog/page/1/"
          class="rounded-lg border border-gray-700 bg-gray-800 px-4 py-2 text-sm text-gray-300"
        >
          More articles →
        </a>
      </nav>
    )}
  </section>
</Layout>