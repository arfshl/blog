---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");

const sortedPosts = posts.sort(
  (a, b) =>
    new Date(b.data.date).getTime() -
    new Date(a.data.date).getTime(),
);

const latestPosts = sortedPosts.slice(0, 3);

const postsPerPage = 6;
const remainingPosts = sortedPosts.slice(3);
const firstPagePosts = remainingPosts.slice(0, postsPerPage);

const hasMorePages = remainingPosts.length > postsPerPage;
---

<Layout
  title="Blog — arfshl"
  description="Articles, notes, and projects by arfshl."
>
  <section class="mb-10">
    <div class="rounded-xl border border-gray-700 bg-gray-800 p-6 shadow-lg sm:p-8">
      <p class="mb-3 text-sm font-medium text-cyan-400">
        ~/blog
      </p>

      <h1 class="mb-4 text-3xl font-bold text-gray-100 sm:text-4xl">
        Articles & Notes
      </h1>

      <p class="max-w-2xl text-gray-400">
        Catatan tentang programming, Linux, web development,
        dan berbagai hal yang sedang saya pelajari.
      </p>
    </div>
  </section>

  <section class="mb-12">
    <div class="mb-6 flex items-center justify-between">
      <h2 class="text-xl font-bold text-gray-100">
        Latest
      </h2>

      <span class="text-sm text-gray-500">
        {latestPosts.length} latest posts
      </span>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {latestPosts.map((post) => (
        <article
          class="group rounded-xl border border-gray-700 bg-gray-800 p-6 shadow-lg transition hover:-translate-y-1 hover:border-cyan-400"
        >
          <div class="mb-4 flex flex-wrap items-center gap-2 text-xs">
            <span class="rounded-md bg-cyan-400/10 px-2 py-1 text-cyan-300">
              {post.data.category}
            </span>

            <span class="text-gray-500">
              {new Date(post.data.date).toLocaleDateString("en-US", {
                year: "numeric",
                month: "short",
                day: "numeric",
              })}
            </span>
          </div>

          <h3 class="mb-3 text-xl font-bold text-gray-100">
            <a
              href={`/blog/${post.data.category}/${post.data.slug}/`}
              class="transition group-hover:text-cyan-400"
            >
              {post.data.title}
            </a>
          </h3>

          <p class="mb-5 text-sm leading-6 text-gray-400">
            {post.data.description}
          </p>

          <span class="rounded bg-gray-700 px-2 py-1 text-xs text-gray-400">
            #{post.data.tags}
          </span>
        </article>
      ))}
    </div>
  </section>

  <section>
    <div class="mb-6 flex items-center justify-between">
      <h2 class="text-xl font-bold text-gray-100">
        All articles
      </h2>

      <span class="text-sm text-gray-500">
        {remainingPosts.length} posts
      </span>
    </div>

    {firstPagePosts.length > 0 ? (
      <div class="space-y-4">
        {firstPagePosts.map((post) => (
          <article
            class="group rounded-xl border border-gray-700 bg-gray-800 p-5 shadow-lg transition hover:border-cyan-400 sm:p-6"
          >
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
              <div class="min-w-0 flex-1">
                <div class="mb-2 flex flex-wrap items-center gap-2 text-xs">
                  <span class="rounded-md bg-cyan-400/10 px-2 py-1 text-cyan-300">
                    {post.data.category}
                  </span>

                  <span class="text-gray-500">
                    {new Date(post.data.date).toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "short",
                      day: "numeric",
                    })}
                  </span>
                </div>

                <h3 class="mb-2 text-xl font-bold text-gray-100">
                  <a
                    href={`/blog/${post.data.category}/${post.data.slug}/`}
                    class="transition group-hover:text-cyan-400"
                  >
                    {post.data.title}
                  </a>
                </h3>

                <p class="text-sm leading-6 text-gray-400">
                  {post.data.description}
                </p>
              </div>

              <span class="shrink-0 self-start rounded bg-gray-700 px-2 py-1 text-xs text-gray-400 sm:self-center">
                #{post.data.tags}
              </span>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="rounded-xl border border-dashed border-gray-700 bg-gray-800 p-10 text-center">
        <p class="text-gray-500">
          Belum ada artikel lainnya.
        </p>
      </div>
    )}

    {hasMorePages && (
      <nav
        class="mt-10 flex items-center justify-center"
        aria-label="Blog pagination"
      >
        <a
          href="/blog/page/2/"
          class="rounded-lg border border-gray-700 bg-gray-800 px-4 py-2 text-sm text-gray-300 transition hover:border-cyan-400 hover:text-cyan-400"
        >
          More articles →
        </a>
      </nav>
    )}
  </section>
</Layout>