---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: {
      category: post.data.category,
      slug: post.data.slug,
    },
    props: {
      post,
    },
  }));
}

const { post } = Astro.props;
---

<Layout
  title={`${post.data.title} — arfshl`}
  description={post.data.description}
>
  <article>
    <div class="mb-8">
      <div class="mb-4 flex flex-wrap items-center gap-2 text-sm">
        <span class="rounded-md bg-cyan-400/10 px-2 py-1 text-cyan-300">
          {post.data.category}
        </span>

        <span class="text-gray-500">
          {new Date(post.data.date).toLocaleDateString("en-US", {
            year: "numeric",
            month: "short",
            day: "numeric",
          })}
        </span>
      </div>

      <h1 class="mb-4 text-3xl font-bold text-gray-100 sm:text-4xl">
        {post.data.title}
      </h1>

      <p class="text-gray-400">
        {post.data.description}
      </p>
    </div>

    <div class="rounded-xl border border-gray-700 bg-gray-800 p-6 shadow-lg">
      <div class="prose prose-invert max-w-none">
        {post.body}
      </div>
    </div>
  </article>
</Layout>
