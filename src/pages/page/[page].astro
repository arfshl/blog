---
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const { getCollection } = await import("astro:content");

  const latestCount = 3;
  const postsPerPage = 6;

  const posts = await getCollection("blog");

  const sortedPosts = posts.sort(
    (a, b) =>
      new Date(b.data.date).getTime() -
      new Date(a.data.date).getTime(),
  );

  const remainingPosts = sortedPosts.slice(latestCount);

  const totalPaginationPages = Math.ceil(
    remainingPosts.length / postsPerPage,
  );

  return Array.from(
    { length: totalPaginationPages },
    (_, index) => {
      const currentPage = index + 2;

      const start = index * postsPerPage;
      const end = start + postsPerPage;

      return {
        params: {
          page: String(currentPage),
        },
        props: {
          posts: remainingPosts.slice(start, end),
          currentPage,
          totalPages: totalPaginationPages + 1,
        },
      };
    },
  );
}

const {
  posts,
  currentPage,
  totalPages,
} = Astro.props;
---

<Layout
  title={`Blog — Page ${currentPage} — arfshl`}
  description={`Blog articles page ${currentPage}.`}
>
  <section>
    <div class="mb-8">
      <p class="mb-3 text-sm font-medium text-cyan-400">
        ~/blog/page/{currentPage}
      </p>

      <h1 class="text-3xl font-bold text-gray-100 sm:text-4xl">
        All articles
      </h1>

      <p class="mt-3 text-gray-400">
        Page {currentPage} of {totalPages}
      </p>
    </div>

    <div class="space-y-4">
      {posts.map((post) => (
        <article
          class="group rounded-xl border border-gray-700 bg-gray-800 p-5 shadow-lg sm:p-6"
        >
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="min-w-0 flex-1">
              <div class="mb-2 flex flex-wrap items-center gap-2 text-xs">
                <span class="rounded-md bg-cyan-400/10 px-2 py-1 text-cyan-300">
                  {post.data.category}
                </span>

                <span class="text-gray-500">
                  {new Date(post.data.date).toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </span>
              </div>

              <h2 class="mb-2 text-xl font-bold text-gray-100">
                <a
                  href={`/blog/${post.data.category}/${post.data.slug}/`}
                  class="transition group-hover:text-cyan-400"
                >
                  {post.data.title}
                </a>
              </h2>

              <p class="text-sm leading-6 text-gray-400">
                {post.data.description}
              </p>
            </div>

            <span class="shrink-0 self-start rounded bg-gray-700 px-2 py-1 text-xs text-gray-400 sm:self-center">
              #{post.data.tags}
            </span>
          </div>
        </article>
      ))}
    </div>

    <nav
      class="mt-10 flex flex-wrap items-center justify-center gap-2"
      aria-label="Blog pagination"
    >
      <a
        href="/blog/"
        class="rounded-lg border border-gray-700 bg-gray-800 px-4 py-2 text-sm text-gray-300"
      >
        ← Home
      </a>

      {currentPage > 2 && (
        <a
          href={`/blog/page/${currentPage - 1}/`}
          class="rounded-lg border border-gray-700 bg-gray-800 px-4 py-2 text-sm text-gray-300"
        >
          ← Previous
        </a>
      )}

      <span class="rounded-lg bg-cyan-400/10 px-4 py-2 text-sm text-cyan-300">
        {currentPage}
      </span>

      {currentPage < totalPages && (
        <a
          href={`/blog/page/${currentPage + 1}/`}
          class="rounded-lg border border-gray-700 bg-gray-800 px-4 py-2 text-sm text-gray-300"
        >
          Next →
        </a>
      )}
    </nav>
  </section>
</Layout>
