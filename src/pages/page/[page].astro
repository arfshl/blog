---
import Layout from "../../layouts/Layout.astro";

// generate paginated blog pages
export async function getStaticPaths() {
  const { getCollection } = await import("astro:content");

  const postsPerPage = 6;

  const posts = await getCollection("blog");

  // sort posts from newest to oldest
  const sortedPosts = posts.sort(
    (a, b) =>
      new Date(b.data.date).getTime() -
      new Date(a.data.date).getTime(),
  );

  const totalPages = Math.ceil(sortedPosts.length / postsPerPage);

  return Array.from(
    { length: totalPages },
    (_, index) => {
      const currentPage = index + 1;

      // calculate the range of posts for the current page
      const start = index * postsPerPage;
      const end = start + postsPerPage;

      return {
        params: {
          page: String(currentPage),
        },
        props: {
          posts: sortedPosts.slice(start, end),
          currentPage,
          totalPages,
        },
      };
    },
  );
}

// get pagination data from the page props
const {
  posts,
  currentPage,
  totalPages,
} = Astro.props;
---

<Layout title={`Blog — Page ${currentPage} — arfshl`} description={`Blog articles page ${currentPage}.`}>
  <section>
    <div class="mb-8">
      <p class="mb-3 text-sm font-medium text-cyan-400">
        ~/blog/page/{currentPage}
      </p>

      <h1 class="text-3xl font-bold text-gray-100 sm:text-4xl">
        All articles
      </h1>

      <p class="mt-3 text-gray-400">
        Page {currentPage} of {totalPages}
      </p>
    </div>

    <div class="space-y-4">
      {posts.map((post) => (
        <article class="group rounded-xl border border-gray-700 bg-gray-800 p-5 shadow-lg sm:p-6">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="min-w-0 flex-1">
              <div class="mb-2 flex flex-wrap items-center gap-2 text-xs">
                <span class="rounded-md bg-cyan-400/10 px-2 py-1 text-cyan-300">
                  {post.data.category}
                </span>

                <span class="text-gray-500">
                  {new Date(post.data.date).toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </span>
              </div>

              <h2 class="mb-2 text-xl font-bold text-gray-100">
                <a href={`/blog/${post.data.category}/${post.data.slug}/`} class="transition group-hover:text-gray-400">
                  {post.data.title}
                </a>
              </h2>

              {post.data.description && (
              <p class="text-gray-400">
              {post.data.description}
              </p>
)}
            </div>

            <span class="shrink-0 self-start rounded bg-gray-700 px-2 py-1 text-xs text-gray-400 sm:self-center">
              #{post.data.tags}
            </span>
          </div>
        </article>
      ))}
    </div>

    <nav class="mt-10 flex flex-wrap items-center justify-center gap-2" aria-label="Blog pagination">
      {currentPage > 1 && (
        <a href="/blog/page/1" class="rounded-lg border border-gray-700 bg-gray-800 px-4 py-2 text-sm text-gray-300 transition hover:bg-gray-700">
          First
        </a>
      )}

      {currentPage > 1 && (
        <a
          href={
            currentPage - 1 === 1
              ? "/blog/"
              : `/blog/page/${currentPage - 1}/`
          }
          class="rounded-lg border border-gray-700 bg-gray-800 px-4 py-2 text-sm text-gray-300 transition hover:bg-gray-700">
          ← Previous
        </a>
      )}

      <span class="rounded-lg bg-cyan-400/10 px-4 py-2 text-sm text-cyan-300" aria-current="page">
        {currentPage}
      </span>

      {currentPage < totalPages && (
        <a href={`/blog/page/${currentPage + 1}/`} class="rounded-lg border border-gray-700 bg-gray-800 px-4 py-2 text-sm text-gray-300 transition hover:bg-gray-700">
          Next →
        </a>
      )}

      {currentPage < totalPages && (
        <a href={`/blog/page/${totalPages}/`} class="rounded-lg border border-gray-700 bg-gray-800 px-4 py-2 text-sm text-gray-300 transition hover:bg-gray-700">
          Last
        </a>
      )}
    </nav>
  </section>
</Layout>